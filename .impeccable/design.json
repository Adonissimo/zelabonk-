  "narrative": {
    "northStar": "The Wanderer's Field Guide",
    "overview": "Relic Wilds puts a warm, readable field-guide interface over a full-screen, explorable fantasy world. Parchment choices, aged gold actions, and deep spruce status panels sit beside original low-poly adventurers and cel-shaded landmarks. This metaphor describes the finished implementation; it is an implementation assumption, not a separately approved comp.\n\nThe scene provides atmosphere and depth. Interface ornament stays small: a relic diamond, thin rules, rounded line icons, and compact labels. Six connected original realms express forest, sea, twilight, sky, volcanic, and moon/time settings through distinct geometry, lighting, fog, and landmarks. The visual authority is the running code and its verified desktop and mobile renders.",
    "keyCharacteristics": [
      "A real Three.js world fills the viewport behind the interface.",
      "Gold actions and parchment selections remain distinct from spruce status surfaces.",
      "Friendly display lettering pairs with sturdy, compact control text.",
      "Native dialogs and visible keyboard focus preserve clear interaction states."
    ],
    "rules": [
      {
        "name": "The Backed Status Rule",
        "body": "Place persistent gameplay text and realm announcements on the implemented dark backing. Text shadow alone is insufficient over changing terrain.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Use Lilita for playful identity and upgrade names, Nunito for controls and facts, and Georgia for the established ceremonial headings.",
        "section": "typography"
      }
    ],
    "dos": [
      "**Do** use the running implementation as visual authority; there is no separately approved comp.",
      "**Do** keep gameplay facts readable on dark backing across all six realms.",
      "**Do** retain self-hosted type, authored SVG icons, and original characters and geometry.",
      "**Do** preserve native button activation, visible focus, dialog pause behavior, and touch control space.",
      "**Do** keep the compact six-realm scope accurate in descriptions and visual extensions."
    ],
    "donts": [
      "**Don't** replace the playable scene with a decorative hero image or a dashboard shell.",
      "**Don't** place persistent gameplay labels directly over terrain using only text shadow.",
      "**Don't** substitute franchise characters, logos, or canonical locations for the original world.",
      "**Don't** imply every location from the inspiration franchises is represented.",
      "**Don't** let global gameplay shortcuts consume Space or Enter on focused native controls."
    ]
