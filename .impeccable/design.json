      "html": "<section class=\"ds-hud\" aria-label=\"Game status\"><strong>125 / 125</strong><div class=\"ds-health\"><span></span></div><div class=\"ds-stamina\"><span></span></div><p>Verdant Reach</p></section>",
      "css": ".ds-hud{font-family:var(--body,Nunito,'Trebuchet MS',sans-serif);font-weight:800;color:var(--cream,#fff5d8);padding:11px 14px;background:#1b3e35ed;border-radius:9px;width:218px;text-shadow:0 2px 7px #18382a66}.ds-hud strong{font-size:13px}.ds-health{height:9px;margin-top:7px;background:#203f38b3;border:1px solid #fff1cc70;border-radius:7px;overflow:hidden}.ds-health span{display:block;height:100%;width:100%;background:#ed8972;transition:width .15s}.ds-stamina{height:4px;margin-top:5px;border:0;border-radius:7px;background:#193d3999;width:100px;overflow:hidden}.ds-stamina span{display:block;height:100%;width:100%;background:#a8e092}.ds-hud p{font-size:12px;margin:10px 0 0;letter-spacing:.5px}@media(max-width:800px){.ds-hud{width:178px;padding:10px 12px}}@media(max-width:560px){.ds-hud{width:124px;padding:9px 10px}.ds-hud strong{font-size:10px}.ds-hud p{font-size:9px}}@media(prefers-reduced-motion:reduce){.ds-health span{transition:none}}"
