      "css": ".ds-primary{font-family:var(--body,Nunito,'Trebuchet MS',sans-serif);font-weight:800;cursor:pointer;transition:background .16s,transform .16s,color .16s}.ds-primary:focus-visible{outline:3px solid #75e1cf;outline-offset:5px}.ds-primary:active:not(:disabled){transform:translateY(2px)}.ds-primary:disabled{cursor:default;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}.ds-primary{min-height:54px;display:flex;align-items:center;justify-content:space-between;gap:25px;border:0;border-radius:8px;background:var(--gold,#edca76);color:#263d32;padding:14px 22px;font-size:15px;font-weight:900;box-shadow:0 6px 20px #17382f26}.ds-primary:hover{background:#f1d797}.ds-primary svg{width:20px;height:20px;stroke:currentColor;stroke-width:1.8;fill:none;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}.ds-primary.ds-menu{min-height:48px;padding:11px 17px}@media(max-width:560px){.ds-primary.ds-menu{font-size:13px;min-height:43px}}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Spruce confirmation action within parchment dialogs.",
      "html": "<button class=\"ds-secondary\">Ready to wander</button>",
      "css": ".ds-secondary{font-family:var(--body,Nunito,'Trebuchet MS',sans-serif);font-weight:800;cursor:pointer;transition:background .16s,transform .16s,color .16s}.ds-secondary:focus-visible{outline:3px solid #75e1cf;outline-offset:5px}.ds-secondary:active:not(:disabled){transform:translateY(2px)}.ds-secondary:disabled{cursor:default;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}}.ds-secondary{padding:11px 20px;background:var(--ink,#29283e);color:var(--cream,#fffdf4);border:0;border-radius:7px;font-size:14px}.ds-secondary:hover{background:#426c56}"
    },
    {
      "name": "Key Binding",
      "kind": "button",
      "refersTo": "binding-button",
      "description": "Two-column action/key controls. The capturing class adds the live green capture treatment.",
      "html": "<div class=\"ds-bindings\"><button class=\"ds-binding\">Jump / glide<kbd>Space</kbd></button><button class=\"ds-binding ds-capturing\">Interact<kbd>Press key</kbd></button></div>",
      "css": ".ds-bindings{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px;margin-top:24px}.ds-binding{font-family:var(--body,Nunito,'Trebuchet MS',sans-serif);font-weight:800;cursor:pointer;border:0;border-radius:8px;background:#ecebf0;min-height:44px;display:flex;align-items:center;justify-content:space-between;gap:9px;padding:9px 12px;color:#47425b;font-size:11px;min-width:0;text-align:left}.ds-binding kbd{font:12px var(--body,Nunito,sans-serif);white-space:nowrap;border:0;background:#fffdf8;color:#39354e;padding:4px 7px;min-width:31px;text-align:center;border-radius:4px}.ds-binding.ds-capturing{outline:2px solid #5d8a76;background:#e4eddf}.ds-capturing kbd{font-size:9px}.ds-binding:hover{cursor:pointer}.ds-binding:focus-visible{outline:3px solid #75e1cf;outline-offset:5px}.ds-binding:active:not(:disabled){transform:translateY(2px)}@media(max-width:560px){.ds-binding{font-size:10px;padding:9px}.ds-binding kbd{font-size:10px;padding:4px;min-width:26px}}"
    },
    {
      "name": "Utility Icon Button",
      "kind": "button",
      "refersTo": "button-icon-playing",
      "description": "Dark indigo utility control used at the lower right during play.",
      "html": "<button class=\"ds-icon\" aria-label=\"How to play\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M9 9c0-4 7-4 6 0-1 2-3 1-3 5m0 3v.1\"/></svg></button>",
      "css": ".ds-icon{font-family:var(--body,Nunito,'Trebuchet MS',sans-serif);font-weight:800;cursor:pointer;transition:background .16s,transform .16s,color .16s}.ds-icon:focus-visible{outline:3px solid #75e1cf;outline-offset:5px}.ds-icon:active:not(:disabled){transform:translateY(2px)}.ds-icon:disabled{cursor:default;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-icon{transition:none}}.ds-icon{width:38px;height:38px;border:1px solid #fff8e0aa;border-radius:50%;background:#292c46df;color:var(--cream,#fffdf4);display:grid;place-items:center}.ds-icon:hover{background:#365950}.ds-icon svg{width:18px;height:18px;stroke:currentColor;stroke-width:1.8;fill:none;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}"
    },
    {
      "name": "Upgrade Choice",
      "kind": "card",
      "refersTo": "upgrade-choice",
      "description": "White native choice card with a colored header, Zelda item, keyboard shortcut, and rank.",
      "html": "<button class=\"ds-upgrade\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m14 4 6-1-1 6-9 9-4-4Z\"/><path d=\"m4 12 8 8M3 21l5-5\"/></svg><kbd>1</kbd><span class=\"ds-kind\">NEW WEAPON</span><h3>Master Sword</h3><p>A sword beam seeks the nearest enemy.</p><span class=\"ds-rank\">RANK 1</span></button>",
      "css": ".ds-upgrade{font-family:var(--body,Nunito,'Trebuchet MS',sans-serif);font-weight:800;cursor:pointer;transition:background .16s,transform .16s,color .16s}.ds-upgrade:focus-visible{outline:3px solid #75e1cf;outline-offset:5px}.ds-upgrade:active:not(:disabled){transform:translateY(2px)}.ds-upgrade:disabled{cursor:default;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-upgrade{transition:none}}.ds-upgrade{border:1px solid #b9c4a7;border-radius:9px;background:#e9ead5;color:var(--ink,#29283e);min-height:215px;width:240px;padding:20px 17px;position:relative;text-align:left;display:flex;flex-direction:column;align-items:flex-start}.ds-upgrade:hover{background:#dfe7cd;border-color:#5a8573;transform:translateY(-3px)}.ds-upgrade>svg{color:#467c6b;margin-bottom:20px}.ds-kind{font-size:8px;letter-spacing:1.6px;color:#5d705c}.ds-upgrade h3{font-family:var(--display,Lilita,Georgia,serif);font-size:23px;font-weight:400;margin:7px 0 8px}.ds-upgrade p{font-size:11px;font-weight:700;line-height:1.55;margin:0;color:#536852}.ds-rank{margin-top:auto;padding-top:14px;font-size:9px;color:#6c794f}.ds-upgrade kbd{position:absolute;top:17px;right:15px;border:1px solid #acb49a;border-radius:4px;padding:3px 5px;font:800 9px var(--body,Nunito,sans-serif);color:#6d7b5e}.ds-upgrade.ds-evolution{background:#dce7ce;border-color:#74a48d}@media(max-width:560px){.ds-upgrade{width:100%;min-height:96px;display:grid;grid-template-columns:32px 1fr;column-gap:13px;padding:13px 16px}.ds-upgrade>svg{grid-column:1;grid-row:1/5;width:28px;height:28px;margin:10px 0 0}.ds-kind,.ds-upgrade h3,.ds-upgrade p,.ds-rank{grid-column:2}.ds-upgrade h3{font-size:20px;margin:3px 0}.ds-upgrade p{font-size:10px}.ds-rank{padding-top:5px;font-size:8px}}.ds-upgrade svg{width:35px;height:35px;stroke:currentColor;stroke-width:1.8;fill:none;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}@media(max-width:560px){.ds-upgrade>svg{width:28px;height:28px}}.ds-upgrade{border:0;box-shadow:0 4px 17px #28385520;background:#fff;border-radius:15px;overflow:hidden;padding-top:86px;min-height:260px}.ds-upgrade>svg{position:absolute;left:0;right:0;top:0;width:100%;height:73px;padding:17px;background:#b8d1e5;color:#3a628b;margin:0}.ds-upgrade:nth-child(2)>svg{background:#ded8b8;color:#766235}.ds-upgrade:nth-child(3)>svg{background:#c4dfbe;color:#4a7653}.ds-upgrade:hover{background:#fbf8eb}.ds-upgrade h3{font-size:24px}.ds-kind{color:#626079}.ds-upgrade p{color:#5a5a70;font-size:12px}.ds-upgrade kbd{z-index:1;background:#ffffffd9;color:#45445e;border:0}.ds-rank{color:#65617b}.ds-banish-mode .ds-upgrade{outline:2px solid #cb8e82}@media(max-width:560px){.ds-upgrade{min-height:100px;padding:13px 14px;grid-template-columns:38px 1fr}.ds-upgrade>svg{position:static;width:34px;height:47px;padding:5px;border-radius:7px;margin:7px 0}.ds-upgrade h3{font-size:21px}.ds-upgrade p{font-size:10px}}"
    },
    {
      "name": "Eight-Map Stage Grid",
      "kind": "nav",
      "refersTo": "stage-card",
      "description": "Eight map-status cards. Adventure advances after each map boss; Survival travel uses gates. Chips show three numbered stages per map.",
      "html": "<nav class=\"ds-stage-grid\" aria-label=\"Realm stages\"><button class=\"ds-stage-card ds-current\" aria-current=\"location\"><span class=\"ds-orb\" style=\"background:#83bc7d\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m12 2-7 9h4l-6 7h18l-6-7h4Zm0 16v4\"/></svg></span><b>Kokiri Forest</b><small>Current map · Level 1-2</small><span class=\"ds-levels\"><i class=\"ds-complete\">1-1</i><i class=\"ds-active\">1-2</i><i class=\"\">1-3</i></span></button><button class=\"ds-stage-card\"><span class=\"ds-orb\" style=\"background:#82c9dc\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M2 8c4-6 6 6 10 0s6 6 10 0M2 15c4-6 6 6 10 0s6 6 10 0\"/></svg></span><b>Lake Hylia</b><small>Preview map</small><span class=\"ds-levels\"><i class=\"\">2-1</i><i class=\"\">2-2</i><i class=\"\">2-3</i></span></button><button class=\"ds-stage-card\"><span class=\"ds-orb\" style=\"background:#a3c874\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m12 2 5 8H7Zm-5 8 5 9H2Zm10 0 5 9H12Z\"/></svg></span><b>Hyrule Field</b><small>Preview map</small><span class=\"ds-levels\"><i class=\"\">3-1</i><i class=\"\">3-2</i><i class=\"\">3-3</i></span></button><button class=\"ds-stage-card\"><span class=\"ds-orb\" style=\"background:#76c9c6\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M2 8c4-6 6 6 10 0s6 6 10 0M2 15c4-6 6 6 10 0s6 6 10 0\"/></svg></span><b>The Great Sea</b><small>Preview map</small><span class=\"ds-levels\"><i class=\"\">4-1</i><i class=\"\">4-2</i><i class=\"\">4-3</i></span></button><button class=\"ds-stage-card\"><span class=\"ds-orb\" style=\"background:#ad91ca\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M20 15A9 9 0 0 1 9 3a9 9 0 1 0 11 12Z\"/></svg></span><b>Twilight Realm</b><small>Preview map</small><span class=\"ds-levels\"><i class=\"\">5-1</i><i class=\"\">5-2</i><i class=\"\">5-3</i></span></button><button class=\"ds-stage-card\"><span class=\"ds-orb\" style=\"background:#abd6df\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M2 11 12 5l10 6-10 7Zm10-6v13M2 11l3 7 7-3 7 3 3-7\"/></svg></span><b>Skyloft</b><small>Preview map</small><span class=\"ds-levels\"><i class=\"\">6-1</i><i class=\"\">6-2</i><i class=\"\">6-3</i></span></button><button class=\"ds-stage-card\"><span class=\"ds-orb\" style=\"background:#9e8bac\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 22V11C12 4 4 3 2 3c0 7 4 10 10 8Zm0 5c0-8 6-11 10-11 0 7-4 10-10 11Z\"/></svg></span><b>The Depths</b><small>Preview map</small><span class=\"ds-levels\"><i class=\"\">7-1</i><i class=\"\">7-2</i><i class=\"\">7-3</i></span></button><button class=\"ds-stage-card\"><span class=\"ds-orb\" style=\"background:#b6b9de\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 6v6l4 2\"/></svg></span><b>Termina Field</b><small>Preview map</small><span class=\"ds-levels\"><i class=\"\">8-1</i><i class=\"\">8-2</i><i class=\"\">8-3</i></span></button></nav>",
      "css": ".ds-stage-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;min-height:330px;margin:22px 0}.ds-stage-card{font-family:var(--body,Nunito,'Trebuchet MS',sans-serif);font-weight:800;cursor:pointer;min-width:0;background:#eeedf0;border:0;border-radius:12px;padding:13px 7px;color:#39354e;display:flex;align-items:center;flex-direction:column;justify-content:center;gap:7px}.ds-stage-card:hover{background:#e5e8df}.ds-stage-card.ds-current{outline:3px solid #648c78;outline-offset:-3px;background:#e9efdf}.ds-orb{display:flex;align-items:center;justify-content:center;border-radius:50%;width:36px;height:36px}.ds-orb svg{width:20px;height:20px;fill:none;stroke:#263f3c;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.ds-stage-card b{font:18px var(--display,Lilita,Georgia,serif);font-weight:400;white-space:normal}.ds-stage-card small{font-size:8px;color:#676078;line-height:1.4;min-height:22px}.ds-levels{display:flex;gap:3px;justify-content:center}.ds-levels i{font-style:normal;font-size:8px;border-radius:4px;padding:4px 5px;background:#d9d7df;color:#625e71}.ds-levels .ds-active{background:#3b5066;color:#fff8df}.ds-levels .ds-complete{background:#547f67;color:#fff8df}.ds-stage-card:focus-visible{outline:3px solid #75e1cf;outline-offset:5px}.ds-stage-card:active:not(:disabled){transform:translateY(2px)}@media(max-width:560px){.ds-stage-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:7px;min-height:510px}.ds-stage-card{padding:10px 6px;gap:4px}.ds-orb{width:27px;height:27px}}"
    },
    {
      "name": "Upgrade Resource Actions",
      "kind": "button",
      "refersTo": "upgrade-refresh",
      "description": "Finite refresh, skip, and banish native actions. Counts and disabled state follow the run.",
      "html": "<div class=\"ds-upgrade-actions\"><button>Refresh (2) · F</button><button>Skip (2) · X</button><button>Banish (1) · Z</button></div>",
      "css": ".ds-upgrade-actions{display:flex;justify-content:center;gap:10px;margin-top:19px}.ds-upgrade-actions button{font-family:var(--body,Nunito,'Trebuchet MS',sans-serif);font-weight:800;cursor:pointer;border:0;border-radius:20px;background:#dceaf4;color:#3c5470;padding:9px 15px;font-size:11px;transition:background .16s,transform .16s,color .16s}.ds-upgrade-actions button:nth-child(2){background:#e9e6dc;color:#5f5b54}.ds-upgrade-actions button:nth-child(3){background:#f4d9d5;color:#894d4d}.ds-upgrade-actions button:hover{cursor:pointer}.ds-upgrade-actions button:focus-visible{outline:3px solid #75e1cf;outline-offset:5px}.ds-upgrade-actions button:active:not(:disabled){transform:translateY(2px)}.ds-upgrade-actions button:disabled{opacity:.5;cursor:default}@media(prefers-reduced-motion:reduce){.ds-upgrade-actions button{transition:none}}"
    },
    {
      "name": "Porcelain Identity Status",
      "kind": "custom",
      "refersTo": "hud-panel",
      "description": "Text-and-meter subset of the identity panel. Production also shows the independently drawn hero portrait.",
      "html": "<section class=\"ds-hud\"><strong>Link</strong><small>Hero of Courage</small><b>100 / 100</b><div class=\"ds-health\"><span></span></div><div class=\"ds-stamina\"><span></span></div><p>Hyrule Field</p></section>",
      "css": ".ds-hud{font-family:var(--body,Nunito,'Trebuchet MS',sans-serif);font-weight:800;background:#fffcf4f5;box-shadow:0 6px 22px #20333830;width:218px;padding:12px 15px;border-radius:15px;color:#2c2a42}.ds-hud>strong{font:23px var(--display,Lilita,Georgia,serif);display:block}.ds-hud>small{font-size:9px;color:#5d6178;display:block;margin:4px 0 9px}.ds-hud>b{font-size:10px}.ds-health{height:7px;margin-top:7px;border:1px solid #9896ad;background:#d9dae5;border-radius:7px;overflow:hidden}.ds-health span{display:block;width:100%;height:100%;background:#82b976}.ds-stamina{height:4px;margin-top:5px;background:#d9dae5;width:100px;border-radius:7px;overflow:hidden}.ds-stamina span{display:block;width:100%;height:100%;background:#6db5c9}.ds-hud p{font-size:10px;color:#5b5b74;margin:8px 0 0}@media(max-width:560px){.ds-hud{width:126px;padding:8px 10px;border-radius:12px}.ds-hud>strong{font-size:17px}.ds-hud>small{font-size:7px}.ds-hud p{font-size:8px}}@media(max-width:379px){.ds-hud{width:102px;padding:8px}.ds-hud>strong{font-size:16px}.ds-hud>small{font-size:6.5px}.ds-hud p{font-size:7.5px}}"
    },
    {
      "name": "Charged Ultimate",
      "kind": "button",
      "refersTo": "ultimate-button",
      "description": "One of six hero Ultimates. Production uses the hero definition, real charge, disabled state, and readiness.",
      "html": "<button class=\"ds-ultimate ds-ready\" aria-label=\"Use Ultimate\"><svg viewBox=\"0 0 64 64\" aria-hidden=\"true\"><circle class=\"ds-ultimate-track\" cx=\"32\" cy=\"32\" r=\"27\"/><circle class=\"ds-ultimate-charge\" cx=\"32\" cy=\"32\" r=\"27\"/></svg><span>R</span><small>SPIN ATTACK</small></button>",
      "css": ".ds-ultimate{font-family:var(--body,Nunito,'Trebuchet MS',sans-serif);font-weight:800;position:relative;width:79px;height:79px;border:0;background:#34334ce8;border-radius:50%;color:#fffaf0;padding:0;opacity:1;box-shadow:0 4px 13px #20333838;cursor:pointer;transition:background .16s,transform .16s,color .16s}.ds-ultimate>svg{position:absolute;inset:0;width:100%;height:100%;transform:rotate(-90deg)}.ds-ultimate-track,.ds-ultimate-charge{fill:none;stroke-width:4;stroke:#9f9db4}.ds-ultimate-charge{stroke:#edd174;stroke-dasharray:170;stroke-dashoffset:170;transition:stroke-dashoffset .15s}.ds-ultimate>span{font:30px var(--display,Lilita,Georgia,serif);display:block;margin-top:2px}.ds-ultimate>small{position:absolute;left:50%;top:-20px;transform:translateX(-50%);white-space:nowrap;font-size:8px;padding:3px 7px;background:#34334ced;border-radius:4px}.ds-ultimate.ds-ready{background:#a88034}.ds-ready .ds-ultimate-charge{stroke:#fff0b1;stroke-dashoffset:0}.ds-ultimate:hover{cursor:pointer}.ds-ultimate:focus-visible{outline:3px solid #75e1cf;outline-offset:5px}.ds-ultimate:active:not(:disabled){transform:translateY(2px)}.ds-ultimate:disabled{cursor:default;opacity:.5}.ds-ultimate:disabled{opacity:1}@media(prefers-reduced-motion:reduce){.ds-ultimate,.ds-ultimate-charge{transition:none}}"
    },
    {
      "name": "Settings Controls",
      "kind": "input",
      "refersTo": "settings-select",
      "description": "Native graphics select, checkbox, and range with the current settings-row layout and field focus.",
      "html": "<div class=\"ds-settings\"><label class=\"ds-setting-row\">Quality<select><option>Low · faster</option><option selected>Balanced</option><option>High · sharper shadows</option></select></label><label class=\"ds-setting-row\">Sound effects<input type=\"checkbox\" checked></label><label class=\"ds-setting-row\">Volume<input type=\"range\" min=\"0\" max=\"1\" step=\"0.05\" value=\"0.55\"></label></div>",
      "css": ".ds-settings{font-family:var(--body,Nunito,'Trebuchet MS',sans-serif);font-weight:800;color:var(--ink,#29283e);background:var(--paper,#fffdf8);padding:12px}.ds-setting-row{display:flex;align-items:center;justify-content:space-between;gap:20px;text-align:left;padding:19px 0;border-bottom:1px solid #dedbe2;font-size:13px}.ds-setting-row input,.ds-setting-row select{font:inherit;color:var(--ink,#29283e);accent-color:#648e80;caret-color:var(--ink,#29283e)}.ds-setting-row select{max-width:210px;font-size:11px;padding:7px 27px 7px 10px;border:1px solid #b7b4c3;border-radius:7px;background:#fffdf8}.ds-setting-row input[type=checkbox]{width:22px;height:22px}.ds-setting-row input[type=range]{flex-shrink:0;width:135px}.ds-setting-row input:focus-visible,.ds-setting-row select:focus-visible{outline:3px solid #397668;outline-offset:4px}@media(max-width:560px){.ds-setting-row{font-size:11px;gap:10px}.ds-setting-row select{max-width:175px;font-size:10px}.ds-setting-row input[type=range]{width:100px}}"
    }
  ],
  "narrative": {
    "northStar": "The Hyrule Survivor Arcade",
    "overview": "ZeldaBonk combines recognizable Legend of Zelda fan depictions with the inspected PokéBonk survivor presentation. Six playable heroes—Link, Zelda, Midna, Tetra, Sheik, and Skull Kid—appear as outlined pixel billboards in textured Three.js arenas. Eight connected maps contain 24 Adventure stages, local enemy species, eight guardians, and final Ganondorf. Survival retains its separate Phantom Ganon encounter, bringing the implemented boss depictions to ten.\n\nLight porcelain panels and indigo text keep combat facts clear; dark navy actions and announcements remain visible over scenery. Gold marks primary actions and Ultimate charge. Lilita gives the interface an arcade voice, while heavy Nunito supports small labels. The established implementation extends this world into the roster, shop, journal, inventory, settings, and save dialogs. Explicit Zelda/PokéBonk direction and implemented renders are the visual authority; there is no separately approved comp or card.",
    "keyCharacteristics": [
      "Independently drawn, cached directional pixel actors and foliage inhabit textured 3D space.",
      "Porcelain status and progression surfaces contrast with dark action hints and announcements.",
      "Character identity, stage progress, minimap, health, weapon ranks, and Ultimate charge stay readable during combat.",
      "White upgrade cards use colored headers and finite refresh, skip, and banish actions.",
      "Settings, roster, journal, and save flows extend the same native-dialog system."
    ],
    "rules": [
      {
        "name": "The Two Materials Rule",
        "body": "Use light porcelain for readable status and choice surfaces, and dark indigo backing for action hints and scene announcements.",
        "section": "colors"
      }
    ],
    "dos": [
      "**Do** preserve the actual Zelda theme and all six recognizable hero fan depictions.",
      "**Do** retain crisp cached sprites, action and phase animation, local enemy species, textured ground, and three-dimensional landmarks.",
      "**Do** keep porcelain status and progression surfaces separate from dark backed actions and announcements.",
      "**Do** bind stage, charge, rank, resource, unlock, checkpoint, and disabled visuals to actual run or profile state.",
      "**Do** preserve native controls, visible focus, nested-dialog pause behavior, and mobile control space."
    ],
    "donts": [
      "**Don't** replace the Zelda theme with invented names or blur the independently drawn pixel art.",
      "**Don't** describe the expanded game as six maps, three total heroes, two-frame walking, or drag-only mouse look.",
      "**Don't** imply complete Zelda maps, complete PokéBonk parity, or verified reference balance formulas.",
      "**Don't** bundle extracted Nintendo or PokéBonk assets; artwork and animation are independently authored.",
      "**Don't** present stage chips, Ultimate charge, unlocks, purchases, saves, or rebinding as decorative controls."
    ]
  }
}
