      "css": ".ds-map{font-family:var(--body,Nunito,'Trebuchet MS',sans-serif);font-weight:800;cursor:pointer;transition:background .16s,transform .16s,color .16s}.ds-map:focus-visible{outline:3px solid #75e1cf;outline-offset:5px}.ds-map:active:not(:disabled){transform:translateY(2px)}.ds-map:disabled{cursor:default;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-map{transition:none}}.ds-map{border:1px solid #fff2d044;background:#1b403baa;color:var(--cream,#fff5d8);border-radius:7px;display:flex;align-items:center;gap:9px;padding:9px 11px;font-size:11px}.ds-map:hover{background:#345a4e}.ds-map kbd{font:800 9px var(--body,Nunito,sans-serif);display:inline-flex;justify-content:center;align-items:center;border:1px solid #fff2d05e;border-radius:4px;padding:3px 5px;min-width:20px}@media(pointer:coarse){.ds-map kbd{display:none}}.ds-map svg{width:17px;height:17px;stroke:currentColor;stroke-width:1.8;fill:none;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}"
