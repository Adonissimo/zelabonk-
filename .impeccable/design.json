      "description": "Gold start, resume, and retry actions.",
      "html": "<button class=\"ds-primary\"><span>Begin adventure</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h16m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-primary{font-family:var(--body,Nunito,'Trebuchet MS',sans-serif);font-weight:800;cursor:pointer;transition:background .16s,transform .16s,color .16s}.ds-primary:focus-visible{outline:3px solid #75e1cf;outline-offset:5px}.ds-primary:active:not(:disabled){transform:translateY(2px)}.ds-primary:disabled{cursor:default;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}.ds-primary{min-height:54px;display:flex;align-items:center;justify-content:space-between;gap:25px;border:0;border-radius:8px;background:var(--gold,#edca76);color:#263d32;padding:14px 22px;font-size:15px;font-weight:900;box-shadow:0 6px 20px #17382f26}.ds-primary:hover{background:#f1d797}.ds-primary svg{width:20px;height:20px;stroke:currentColor;stroke-width:1.8;fill:none;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}"
