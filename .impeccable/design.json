      "css": ".ds-upgrade{font-family:var(--body,Nunito,'Trebuchet MS',sans-serif);font-weight:800;cursor:pointer;transition:background .16s,transform .16s,color .16s}.ds-upgrade:focus-visible{outline:3px solid #75e1cf;outline-offset:5px}.ds-upgrade:active:not(:disabled){transform:translateY(2px)}.ds-upgrade:disabled{cursor:default;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-upgrade{transition:none}}.ds-upgrade{border:1px solid #b9c4a7;border-radius:9px;background:#e9ead5;color:var(--ink,#233e36);min-height:215px;width:240px;padding:20px 17px;position:relative;text-align:left;display:flex;flex-direction:column;align-items:flex-start}.ds-upgrade:hover{background:#dfe7cd;border-color:#5a8573;transform:translateY(-3px)}.ds-upgrade>svg{color:#467c6b;margin-bottom:20px}.ds-kind{font-size:8px;letter-spacing:1.6px;color:#5d705c}.ds-upgrade h3{font-family:var(--display,Lilita,Georgia,serif);font-size:23px;font-weight:400;margin:7px 0 8px}.ds-upgrade p{font-size:11px;font-weight:700;line-height:1.55;margin:0;color:#536852}.ds-rank{margin-top:auto;padding-top:14px;font-size:9px;color:#6c794f}.ds-upgrade kbd{position:absolute;top:17px;right:15px;border:1px solid #acb49a;border-radius:4px;padding:3px 5px;font:800 9px var(--body,Nunito,sans-serif);color:#6d7b5e}.ds-upgrade.ds-evolution{background:#dce7ce;border-color:#74a48d}@media(max-width:560px){.ds-upgrade{width:100%;min-height:96px;display:grid;grid-template-columns:32px 1fr;column-gap:13px;padding:13px 16px}.ds-upgrade>svg{grid-column:1;grid-row:1/5;width:28px;height:28px;margin:10px 0 0}.ds-kind,.ds-upgrade h3,.ds-upgrade p,.ds-rank{grid-column:2}.ds-upgrade h3{font-size:20px;margin:3px 0}.ds-upgrade p{font-size:10px}.ds-rank{padding-top:5px;font-size:8px}}.ds-upgrade svg{width:35px;height:35px;stroke:currentColor;stroke-width:1.8;fill:none;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}@media(max-width:560px){.ds-upgrade>svg{width:28px;height:28px}}"
